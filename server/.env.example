# Port to listen on.
PORT=8787
# Postgres connection string. Unset = PGlite (Postgres in WebAssembly) in memory,
# which is what tests and quick local runs use. Set PGLITE_DIR to keep PGlite data on disk.
DATABASE_URL=
PGLITE_DIR=
# Browser origin allowed to call the API (the deployed app's origin). '*' for development.
CORS_ORIGIN=*
